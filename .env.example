# Topline public client configuration. Copy to .env.local for local development.
# Use the dedicated Topline Supabase project and its publishable/anon key only.
VITE_SUPABASE_URL=https://zmbsskvnzjdaxuxlauyx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_TOPLINE_PUBLIC_KEY
# Legacy anon key is supported if publishable keys are not available:
# VITE_SUPABASE_ANON_KEY=REPLACE_WITH_TOPLINE_ANON_KEY
VITE_SITE_URL=https://toplineflooringandwaterproofing.co.ke
# Optional approved observability endpoint:
# VITE_LOGGING_API_ENDPOINT=

# Optional explicit E2E mutation settings; use an isolated staging project and test account.
# E2E_RUN_MUTATIONS=true
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# For an isolated staging project, set this to the exact VITE_SUPABASE_URL before mutation tests.
# E2E_EXPECTED_SUPABASE_URL=https://your-isolated-staging-project.supabase.co
# Production mutations are blocked unless explicitly overridden (not recommended).
# E2E_ALLOW_PRODUCTION_MUTATIONS=false
