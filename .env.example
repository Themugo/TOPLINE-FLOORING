# Topline Flooring & Waterproofing — browser configuration
# These values belong to the dedicated Topline Supabase project.
VITE_SUPABASE_URL=https://<topline-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<topline-anon-key>

# Canonical public site URL used by sitemap/SEO tooling.
VITE_SITE_URL=https://<topline-production-domain>

# Optional approved observability endpoint. Leave unset to use console-only diagnostics.
# VITE_LOGGING_API_ENDPOINT=https://<approved-observability-endpoint>
