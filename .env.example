# TOPLINE FLOORING & ROOFING - browser (Vite) environment template.
# Copy to .env.local for local work; set the same names in Vercel > Project > Settings > Environment Variables.
# Only public, browser-safe values belong in this file. NEVER put a Supabase service-role key,
# provider API key, webhook secret or SMTP password here: those live in Supabase Edge Function secrets.

# Dedicated Topline Supabase project
VITE_SUPABASE_URL=https://zmbsskvnzjdaxuxlauyx.supabase.co
# Supabase "publishable" (anon) key. Safe for the browser because row-level security protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical public site URL (used for sitemap, canonical links and auth redirects)
VITE_SITE_URL=https://toplineflooringandwaterproofing.co.ke

# Optional: client error-reporting endpoint
# VITE_LOGGING_API_ENDPOINT=

# Server-side secrets are configured with "supabase secrets set", not here. Names only:
#   BREVO_API_KEY, BREVO_MARKETING_LIST_ID, BREVO_SENDER_EMAIL  (email delivery + marketing sync)
#   TOPLINE_WORKER_SECRET                                       (scheduler / worker authentication)
#   TOPLINE_WEB_ORIGIN                                          (extra allowed browser origins, comma separated)
#   PAYMENT_WEBHOOK_SECRET, PAYMENT_CARD_WEBHOOK_SECRET, MPESA_*  (payment providers)
